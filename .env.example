# Local development works without credentials. Never commit .env or the data directory.
PORT=5173
NODE_ENV=development
DATA_DIR=data
RETENTION_DAYS=180
SERVICE_AREAS_FILE=config/service-areas.json

# Required for production: your verified HTTPS origin, with no trailing slash.
SITE_URL=
# Optional additional trusted origins, comma-separated. Usually leave blank.
ALLOWED_ORIGINS=
# Set to the exact trusted reverse-proxy hop count, e.g. 1, only when applicable.
TRUST_PROXY_HOPS=

# Production requires a 32-byte key, represented by 64 hex characters.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Do not change the key for an existing database without a proper re-encryption migration.
PII_ENCRYPTION_KEY=

# Only populate these with business-verified information. Blanks remain clearly unavailable.
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_HOURS=
# Country code plus number, digits only. Floating WhatsApp button stays hidden while blank.
BUSINESS_WHATSAPP=
# A verified HTTPS Google Maps location URL. No invented map marker is shown.
BUSINESS_MAPS_URL=